# Copy to .env.local. Server only: never put these in a NEXT_PUBLIC_ variable. Never commit .env.local.
# AI for leave reasons. Leave empty to use the keyword fallback.
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
RUNPOD_MODEL=
# Shared database (optional, Postgres, UTF8). Empty = every browser keeps its own copy. On Replit it comes from Secrets.
DATABASE_URL=
# Optional: key that signs the sign-in cookie in database mode (default: derived from DATABASE_URL).
SESSION_SECRET=
